# ─── Local development ────────────────────────────────────────────────────

# Agent (required locally; in production each school adds its own key in the
# app, or uses Ellai's managed key below)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Give a brand-new user their own school on first sign-in.
#
# LOCAL ONLY. Leave this on while developing, so the first account you create
# becomes an admin with a school to set up.
#
# NEVER set it in production: with it on, anyone who reaches the sign-up page
# gets their own empty school inside your deployment. In production, create the
# school first and invite its admin, so signing up without an invitation grants
# nothing.
AUTO_CREATE_DEFAULT_ORG=true

# ─── Production (set in the host's dashboard, never in the repo) ──────────
#
# Core
# NODE_ENV=production
# DATABASE_URL=postgres://...                 # Neon pooled URL (quote it: it contains &)
# BETTER_AUTH_SECRET=random-32-byte-hex       # openssl rand -hex 32; new value signs everyone out
# BETTER_AUTH_URL=https://crestfield.ellai.dev
# APP_URL=https://crestfield.ellai.dev
# SCHOOL_BASE_DOMAIN=ellai.dev                # optional; defaults to ellai.dev
#
# Demo only, while no email is configured. Never on a real school's server.
# ALLOW_UNVERIFIED_SIGNUP=1
# AUTH_SKIP_EMAIL_VERIFICATION=1
# ALLOW_OPEN_SIGNUP=1                         # anyone who signs up gets their own school
#
# Email (Resend). The school's name replaces the display name on each message;
# only the address here is used, so a neutral name is right.
# RESEND_API_KEY=your-resend-api-key
# EMAIL_FROM=Ellai <noreply@ellai.dev>
#
# Managed assistant and credit
# ELLAI_MANAGED_ANTHROPIC_KEY=your-anthropic-key     # shared key for schools on Ellai credit
# ELLAI_OPERATOR_EMAILS=you@example.com,other@example.com
# ELLAI_TOPUP_INSTRUCTIONS=Pay by bank transfer to: ...   # shown in the Top up dialog
#
# Daily job (Vercel Cron sends this as a bearer token to /api/school/cron/daily)
# CRON_SECRET=random-hex
# DIGEST_MAX_PER_RUN=                         # optional cap on digests per run
#
# Browser push notifications. Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@ellai.dev
#
# Pilot booking on the landing page (Cal.com)
# CAL_LINK=https://cal.com/your-name/pilot-call
# CAL_WEBHOOK_SECRET=random-hex               # same value as the webhook's secret in Cal.com
