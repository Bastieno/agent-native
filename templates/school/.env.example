# Agent (required)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Give a brand-new user their own school on first sign-in.
#
# LOCAL ONLY. Leave this on while developing, so the first account you create
# becomes an admin with a school to set up.
#
# NEVER set it in production: with it on, anyone who reaches the sign-up page
# gets their own empty school inside your deployment. In production, create the
# school first and invite its admin, so signing up without an invitation grants
# nothing.
AUTO_CREATE_DEFAULT_ORG=true

# Resend API Key
RESEND_API_KEY=your-resend-api-key

# Auth (required in production — auto-generated locally if omitted)
# BETTER_AUTH_SECRET=random-32-byte-hex-string
# BETTER_AUTH_URL=http://localhost:5173

# Database (defaults to local SQLite at data/app.db — no setup needed for local dev)
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-auth-token
