{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:lazy",
        "--",
        "--all"
      ],
      "port": 8080
    },
    {
      "name": "school",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--dir",
        "templates/school",
        "dev",
        "--port",
        "8130",
        "--strictPort"
      ],
      "port": 8130,
      "autoPort": false
    },
    {
      "name": "school-showcase",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--dir",
        "templates/school",
        "dev:showcase"
      ],
      "port": 8131,
      "autoPort": false
    },
    {
      "name": "school-journeys",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--dir",
        "templates/school",
        "dev:journeys"
      ],
      "port": 8132,
      "autoPort": false
    },
    {
      "name": "school-journeys-invite-only",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "AUTO_CREATE_DEFAULT_ORG=",
        "corepack",
        "pnpm",
        "--dir",
        "templates/school",
        "dev:journeys"
      ],
      "port": 8132,
      "autoPort": false
    },
    {
      "name": "school-yellowview",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--dir",
        "templates/school",
        "dev:yellowview"
      ],
      "port": 8133,
      "autoPort": false
    },
    {
      "name": "school-crestfield-check",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=file:./data/crestfield-check.db",
        "BETTER_AUTH_URL=http://localhost:8134",
        "corepack",
        "pnpm",
        "--dir",
        "templates/school",
        "exec",
        "agent-native",
        "dev",
        "--port",
        "8134",
        "--strictPort"
      ],
      "port": 8134,
      "autoPort": false
    }
  ]
}
